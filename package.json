{
  "name": "isinglass",
  "version": "0.1.0",
  "description": "A minimal, translucent Obsidian theme for macOS, Windows, and iOS.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && npm run check",
    "watch": "node scripts/build.mjs --watch",
    "check": "node scripts/contrast-check.mjs && node scripts/budget-check.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:budget": "node scripts/budget-check.mjs"
  },
  "devDependencies": {
    "sass": "^1.83.0"
  },
  "license": "MIT"
}
